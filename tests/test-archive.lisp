                    (note interface-01 poured))
           :archive nil)
  (gp-remember-procedure :name 'refill-noted)
  (gp-remove-operator 'pour)
  (gp-add-fact '(charge-state interface-01 empty))
  (gp-add-operator
   (make-operator :name 'charge
